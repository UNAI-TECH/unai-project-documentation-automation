{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UTDA Approval Record",
  "type": "object",
  "required": [
    "project_id",
    "document_id",
    "section_id",
    "change_id",
    "approver_identity",
    "approver_role",
    "decision",
    "timestamp",
    "evidence_reference"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "enum": [
        "D01",
        "D02",
        "D03",
        "D04",
        "D05",
        "D06",
        "D07",
        "D08",
        "D09",
        "D10",
        "D11",
        "D12",
        "D13",
        "D14",
        "D15",
        "MASTER",
        "COMPANY_MASTER"
      ]
    },
    "section_id": {
      "type": "string"
    },
    "change_id": {
      "type": "string"
    },
    "approver_identity": {
      "type": "string"
    },
    "approver_role": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "changes_requested",
        "auto_published"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_reference": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
