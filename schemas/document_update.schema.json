{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UTDA Document Update Proposal",
  "type": "object",
  "required": [
    "project_id",
    "event_key",
    "updates",
    "uncertainties"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "event_key": {
      "type": "string"
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "section",
          "action",
          "content",
          "evidence_refs",
          "approval_class"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "action": {
            "enum": [
              "replace_section",
              "append_entry",
              "update_table_rows",
              "no_change"
            ]
          },
          "content": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_class": {
            "enum": [
              "routine",
              "review",
              "mandatory_human"
            ]
          },
          "reason": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_inferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}